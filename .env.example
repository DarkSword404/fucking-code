# ---- Fucking Code ----
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5174

# dev     = single seeded local user, no login required (default)
# session = cookie-based login/registration, each account gets its own workspace
# required = every request must carry an authenticated user header
AUTH_MODE=dev

# Required for self-service registration when AUTH_MODE=session.
SIGNUP_INVITE_CODE=
# Set true when the app is served over HTTPS (Cloudflare Tunnel / reverse proxy).
COOKIE_SECURE=false

# Public demo mode: disables host code execution and applies daily message caps.
DEMO_MODE=0
DEMO_MESSAGES_PER_USER_PER_DAY=20
DEMO_MESSAGES_PER_DAY=200

# Embedded Postgres (PGlite) data directory. Use a real PostgreSQL by setting
# DATABASE_URL later; the SQL schema is PostgreSQL-compatible.
PGDATA=./data/pg

# ---- Agent runtime ----
# opencode = call the local OpenCode server (real agents, tools available)
# mock     = deterministic scripted agents, no model calls (CI / offline)
AGENT_RUNTIME=opencode

# OpenCode service. If unset, the server reads ~/.config/opencode/service.json
# and derives Basic auth credentials from it.
OPENCODE_URL=http://127.0.0.1:49374
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=

# Model used by discussion agents (must support text generation).
AGENT_MODEL_PROVIDER=opencode-go
AGENT_MODEL_ID=deepseek-v4.1-flash

# ---- Group-chat turn budget ----
# Each user message starts a shared-room turn. Every enabled agent reads it and
# decides whether to speak; speakers' messages trigger another round.
MAX_ROUNDS=4
MAX_SPEAKERS_PER_ROUND=1
MAX_MESSAGES_PER_TURN=8
MAX_MESSAGES_PER_AGENT=2
ATTENTION_CONCURRENCY=4

# Cheap model used only for the "should I speak?" decision.
ATTENTION_MODEL_PROVIDER=opencode-go
ATTENTION_MODEL_ID=mimo-v2.6-flash

# ---- Workspaces (code execution) ----
WORKSPACE_ROOT=./data/worktrees
# Local repositories that may be imported, separated by ':'
ALLOWED_REPO_ROOTS=./data/repos
# The demo project's local fixture repository
DEMO_REPO_ROOT=./data/repos

# Test/terminal command sandbox. bwrap is recommended on Linux; use "process" to disable.
SANDBOX_MODE=bwrap
# Optional: create GitHub PRs after pushing a review branch.
# GITHUB_TOKEN=github_pat_xxx
# Stale accepted/proposed memories become superseded after this many days.
MEMORY_DECAY_DAYS=180
