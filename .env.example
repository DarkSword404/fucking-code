# ---- Fucking Code ----
PORT=8787
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:5174

# dev     = single seeded local user, no login required (default)
# session = cookie-based login/registration, each account gets its own workspace
# required = every request must carry an authenticated user header
AUTH_MODE=dev

# Required for self-service registration when AUTH_MODE=session.
SIGNUP_INVITE_CODE=
# Set true when the app is served over HTTPS (Cloudflare Tunnel / reverse proxy).
COOKIE_SECURE=false

# Public demo mode: disables host code execution and applies daily message caps.
DEMO_MODE=0
DEMO_MESSAGES_PER_USER_PER_DAY=20
DEMO_MESSAGES_PER_DAY=200

# Embedded Postgres (PGlite) data directory. Use a real PostgreSQL by setting
# DATABASE_URL later; the SQL schema is PostgreSQL-compatible.
PGDATA=./data/pg

# ---- Agent runtime ----
# opencode = call the local OpenCode server (real agents, tools available)
# mock     = deterministic scripted agents, no model calls (CI / offline)
AGENT_RUNTIME=opencode

# Inference-only gateway. The chat/verification layer uses this, so it can run
# without OpenCode sessions. `opencode` reuses the local subscription;
# `openai` points at any OpenAI-compatible API with MODEL_API_KEY.
MODEL_GATEWAY=opencode
# MODEL_API_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=

# Code task executor. `builtin` runs Fucking Code's own file/shell loop through
# the gateway; `opencode` keeps the old OpenCode session path.
CODE_EXECUTOR=builtin
CODE_AGENT_MAX_STEPS=20
# CODE_AGENT_TIMEOUT_MS=1200000

# Command runner. `host` runs tests on the host (simple, less isolated).
# `docker` runs allow-listed commands in a short-lived container with the
# workspace bind-mounted, no network by default, and CPU/memory/PID limits.
# Pull the image first, e.g. `docker pull node:22-bookworm-slim`.
RUNNER_MODE=host
# RUNNER_IMAGE=node:22-bookworm-slim
# RUNNER_MEMORY=1g
# RUNNER_CPUS=2
# RUNNER_PIDS_LIMIT=256

# Preview runner. `host` starts the project on the host; `docker` starts it in
# a short-lived container published only on 127.0.0.1 with a TTL.
PREVIEW_MODE=host
# PREVIEW_IMAGE=node:22-bookworm-slim
# PREVIEW_TTL_MS=1800000


# OpenCode service. If unset, the server reads ~/.config/opencode/service.json
# and derives Basic auth credentials from it.
OPENCODE_URL=http://127.0.0.1:49374
# OPENCODE_USERNAME=opencode
# OPENCODE_PASSWORD=

# Model used by discussion agents (must support text generation).
AGENT_MODEL_PROVIDER=opencode-go
AGENT_MODEL_ID=deepseek-v4.1-flash

# ---- Group-chat turn budget ----
# 0 = no fixed cap. The room stops when nobody wants to speak, when a round
# repeats itself, or when the user presses Stop. MAX_SPEAKERS_PER_ROUND=1
# keeps the single-speaker rule; it is not a total conversation cap.
MAX_ROUNDS=0
MAX_SPEAKERS_PER_ROUND=1
MAX_MESSAGES_PER_TURN=0
MAX_MESSAGES_PER_AGENT=0
ATTENTION_CONCURRENCY=4

# Cheap model used only for the "should I speak?" decision.
ATTENTION_MODEL_PROVIDER=opencode-go
ATTENTION_MODEL_ID=mimo-v2.6-flash

# ---- Workspaces (code execution) ----
WORKSPACE_ROOT=./data/worktrees
# Long coding tasks get more room; an orphaned task is recovered on restart.
CODE_TASK_TIMEOUT_MS=1800000
# Read-only QA/Security/DevOps browser workbenches need longer walls.
WORKBENCH_TIMEOUT_MS=2700000
VERIFY_TIMEOUT_MS=480000
# Local repositories that may be imported, separated by ':'
ALLOWED_REPO_ROOTS=./data/repos
# The demo project's local fixture repository
DEMO_REPO_ROOT=./data/repos
# New projects without a repo get an empty Git repo here (must be under ALLOWED_REPO_ROOTS)
PROJECT_REPO_ROOT=./data/repos

# Test/terminal command sandbox. bwrap is recommended on Linux; use "process" to disable.
SANDBOX_MODE=bwrap
# Optional: create GitHub PRs after pushing a review branch.
# GITHUB_TOKEN=github_pat_xxx
# Stale accepted/proposed memories become superseded after this many days.
MEMORY_DECAY_DAYS=180
